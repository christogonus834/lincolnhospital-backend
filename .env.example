# ---- Server ----
NODE_ENV=production
PORT=3000
# Exact frontend URL(s), comma separated, NO trailing slash. Required in production.
CLIENT_ORIGIN=https://your-frontend.vercel.app
# Random string, 32+ chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sterling-media

# ---- Brevo (doctor booking alerts) ----
BREVO_API_KEY=
# Must be a sender you have verified in Brevo (Senders, Domains & Dedicated IPs)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Sterling Specialist Hospital
# Optional: reception gets a copy of every doctor alert
APPOINTMENT_CC_EMAIL=

# ---- First admin (used only by `npm run seed`; remove afterwards) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
